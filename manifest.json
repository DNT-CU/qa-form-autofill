{
  "manifest_version": 3,
  "name": "Autofill QA – Relleno de formularios de prueba",
  "version": "1.1.0",
  "description": "Extensión simple para prellenar formularios con datos de prueba y opciones al azar.",
  "author": "Dante Curín",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "homepage_url": "https://dantecurin.com",
  "minimum_chrome_version": "88"
}