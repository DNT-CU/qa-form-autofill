{
  "manifest_version": 3,
  "name": "Autofill QA: Forms testing filler",
  "version": "1.1.0",
  "description": "Extensión simple para prellenar formularios con datos de prueba y opciones al azar.",
  "author": "Dante Curín",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/qa-form-logo-16.png",
      "48": "icons/qa-form-logo-48.png",
      "128": "icons/qa-form-logo-128.png"
    }
  },
  "icons": {
    "16": "icons/qa-form-logo-16.png",
    "48": "icons/qa-form-logo-48.png",
    "128": "icons/qa-form-logo-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "homepage_url": "https://dantecurin.com",
  "minimum_chrome_version": "88",

 "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "commands": {
    "autofill-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Ejecutar el autocompletado en la pestaña activa"
    }
  }
}