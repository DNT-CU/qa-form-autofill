{
  "manifest_version": 3,
  "name": "Autofill QA: Forms testing filler",
  "version": "1.7.0",
  "description": "A simple Chrome extension that auto-fills forms with random test data for QA and development.",
  "author": "Dante Curín",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/qa-form-logo-16.png",
      "48": "icons/qa-form-logo-48.png",
      "128": "icons/qa-form-logo-128.png"
    }
  },
  "icons": {
    "16": "icons/qa-form-logo-16.png",
    "48": "icons/qa-form-logo-48.png",
    "128": "icons/qa-form-logo-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "homepage_url": "https://dantecurin.com",
  "minimum_chrome_version": "88",

 "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}